# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Cypress examples

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Impeccable's design hook. config.json is the shared setting and is committed;
# everything else here is this machine's own — the consent record, the dedup
# cache, and the event file the live browser mode writes.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/live/
# Screenshots taken to review a build against itself. Evidence for one pass,
# not source: the brief and DESIGN.md are what outlive it.
.impeccable/review/

# The local copy of everything the site is made of, if it is ever pointed here.
# `scripts/backup/backup.mjs` writes to `../juanmamoreno-archive/current` by
# default and belongs there — ten gigabytes inside this repository would fight
# the build's file watcher, and the archive's own README says why it sits
# outside both repositories. This line is the guard for `--to backup`, so
# pointing it inside is safe rather than a mistake nobody notices until a push.
/backup

# Impeccable's engine ships as a 2.3 MB provider skill folder, and the hook can
# only be wired when it sits here: the install is this machine's, not the
# repository's. `.claude/settings.local.json` that `hooks on` writes is already
# untracked for the same reason.
.claude/skills/impeccable/
