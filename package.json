{
  "name": "juanmamoreno",
  "version": "1.23.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:e2e": "node --test e2e/*.test.mjs",
    "pretty": "prettier --write .",
    "predeploy": "npm run lint && npm test",
    "deploy": "npm run build && ng deploy --no-build --dir=dist/juanmamoreno/browser --cname=juanmamoreno.com",
    "lint": "ng lint",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/verify-render.mjs && node scripts/verify-requirements.mjs",
    "prebuild": "node scripts/write-version.mjs && node scripts/generate-artworks-fallback.mjs",
    "verify:requirements": "node scripts/verify-requirements.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/material": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/ssr": "22.1.4",
    "@datorama/akita": "8.0.1",
    "@fontsource/material-icons": "5.3.0",
    "@ngx-translate/core": "18.0.0",
    "jspdf": "4.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "angular-cli-ghpages": "3.1.0",
    "angular-eslint": "22.0.0",
    "eslint": "10.6.0",
    "jsdom": "29.1.1",
    "ngx-sitemap": "1.0.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@datorama/akita": {
      "tslib": "2.8.1"
    }
  }
}
